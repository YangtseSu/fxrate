# Maintainer: Yangtse Su <yangtsesu@gmail.com>

pkgname=huobi
pkgver=0.2.1
pkgrel=1
pkgdesc="Offline currency conversion CLI backed by Frankfurter or exchange-api rates"
arch=('x86_64' 'aarch64')
url="https://github.com/YangtseSu/huobi"
license=('GPL-3.0-only')
depends=()
makedepends=('rust')
source=("$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('49a4b21a6ee5f4ceae8b3d0c23d3e9f01d0229d8f090cd1b27832279876557fb')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  # ring's bundled C/assembly does not link with Arch's global LTO flag.
  CFLAGS="${CFLAGS//-flto=auto/}" \
    CXXFLAGS="${CXXFLAGS//-flto=auto/}" \
    cargo build --release --locked
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  cargo test --locked
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 target/release/huobi "$pkgdir/usr/bin/huobi"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
